{
  "version": 2,
  "builds": [
    {
      "src": "nutrition-tracker/frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "nutrition-tracker/backend/src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "nutrition-tracker/backend/src/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "nutrition-tracker/frontend/$1"
    }
  ]
}
